{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext", "deno.webgpu", "deno.ns"],
    "strict": true
  },
  "tasks": {
    "dev": "deno run -A tools/dev.ts",
    "build": "deno run -A tools/build.ts",
    "bridge": "deno run -A tools/bridge.ts",
    "host": "deno run -A tools/host.ts",
    "share": "deno run -A tools/share.ts",
    "check": "deno check src tools relay && deno lint && deno fmt --check",
    "test": "deno test --parallel --allow-read=.",
    "shot": "deno run -A tools/shot.ts",
    "camshot": "deno run -A tools/camshot.ts"
  },
  "fmt": { "lineWidth": 100, "exclude": ["dist"] },
  "lint": { "exclude": ["dist"] }
}
