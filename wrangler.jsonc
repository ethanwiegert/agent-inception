// The hosted site and relay (ADR 0006): `npx wrangler deploy` builds `dist/` first (the "build"
// command below), so it works from a fresh clone, as in Cloudflare's Git builds. Deno comes from
// npm there (the official `deno` package), since the build image doesn't ship it.
{
  "name": "agent-inception",
  "main": "relay/worker.ts",
  "compatibility_date": "2025-09-01",
  "build": { "command": "npx -y deno@2.9.6 task build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The pages that name the site's own address: the Worker fills it in (relay/site.ts).
    "run_worker_first": ["/", "/robots.txt", "/sitemap.xml", "/llms.txt"]
  },
  // Once a custom domain is on, pin it as the one canonical address (or turn off workers.dev with
  // "workers_dev": false), so search engines don't see two copies of the site:
  // "vars": { "SITE_URL": "https://your.domain" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }],
  // Branch builds run `npx wrangler preview`. Previews don't inherit bindings (assets, migrations
  // and compatibility do), so ROOMS is declared again; with no script_name each Preview gets its own
  // RoomObject namespace, never production's rooms.
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "ROOMS", "class_name": "RoomObject" }]
    }
  }
}
