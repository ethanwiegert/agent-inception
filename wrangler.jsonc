// The hosted site and relay (ADR 0006). Build first (`deno task build`), then `npx wrangler deploy`.
{
  "name": "agent-inception",
  "main": "relay/worker.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }]
}
